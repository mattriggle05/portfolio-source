---
import "../styles/global.css";
import StyleSwitcher from "../components/StyleSwitcher.astro";
import { themes } from "../themes/registry";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="A visual study in modular layouts. A fresh bento concept for mriggle.dev." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {themes.map((theme, index) => (
      <link rel="stylesheet" href={theme.stylesheet} data-style={theme.id} data-portrait={theme.portrait} data-portrait-alt={theme.portraitAlt} media={index === 0 ? "all" : "not all"} />
    ))}
    <script is:inline>
      const requestedStyle = new URLSearchParams(location.search).get('style');
      const themeSheets = Array.from(document.querySelectorAll('link[data-style]'));
      const initialStyle = themeSheets.find(sheet => sheet.dataset.style === requestedStyle)?.dataset.style || themeSheets[0].dataset.style;
      document.documentElement.dataset.style = initialStyle;
      document.querySelectorAll('link[data-style]').forEach(sheet => {
        sheet.media = sheet.dataset.style === initialStyle ? 'all' : 'not all';
      });
    </script>
    <title>mriggle.dev</title>
  </head>
  <body><StyleSwitcher /><slot /></body>
</html>
