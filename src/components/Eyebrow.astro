---
import type { HTMLAttributes } from "astro/types";
type Props = HTMLAttributes<"span">;
const { class: className, ...attributes } = Astro.props;
---
<span {...attributes} class:list={["eyebrow", className]}><slot /></span>
<style>
  .eyebrow {
    /* Shared typography for all eyebrows; tile styles handle positioning only. */
    font-family: var(--font-body);
    color: var(--color-muted);
    font-size: 8px;
    line-height: 1.5;
    font-weight: 600;
    letter-spacing: 0.17em;
  }
</style>
