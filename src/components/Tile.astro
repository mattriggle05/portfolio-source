---
import type { HTMLAttributes } from "astro/types";
interface Props extends HTMLAttributes<"article"> {
  gridArea: string;
  as?: "article" | "figure";
}
const { as: Tag = "article", gridArea, class: className, ...attributes } = Astro.props;
---
<Tag {...attributes} class:list={["tile", className]} style={{ gridArea }}><slot /></Tag>

<style>
  .tile {
    min-width: 0;
    position: relative;
    border: 1px solid var(--color-edge);
    border-radius: 18px;
    background: linear-gradient(
      145deg,
      var(--color-surface),
      var(--color-surface-dark)
    );
    box-shadow:
      inset 0 1px 0 color-mix(in srgb, var(--color-text) 12%, transparent),
      0 8px 24px color-mix(in srgb, var(--color-background) 85%, transparent);
  }
</style>
