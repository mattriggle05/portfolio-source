---
import TextBoxTile from "./tiles/TextBoxTile.astro";
import ImageTile from "./tiles/ImageTile.astro";
import ProjectsTile from "./tiles/ProjectsTile.astro";
import LocationTile from "./tiles/LocationTile.astro";
import ContactTile from "./tiles/ContactTile.astro";
import TechnologyTile from "./tiles/TechnologyTile.astro";
import ResumeTile from "./tiles/ResumeTile.astro";
import SignatureProjectTile from "./tiles/SignatureProjectTile.astro";
---

<main class="concept">
  <section class="bento-grid" aria-label="Bento concept with placeholder content">
    <TextBoxTile gridArea="1 / 1 / 4 / 7" className="tile" />
    <ImageTile gridArea="1 / 7 / 5 / 10" className="tile" />
    <ProjectsTile gridArea="4 / 10 / 8 / 13" className="tile" />
    <LocationTile gridArea="1 / 10 / 4 / 13" className="tile" />
    <ContactTile gridArea="4 / 5 / 6 / 7" className="tile" />
    <TechnologyTile gridArea="6 / 5 / 8 / 10" className="tile" />
    <ResumeTile gridArea="5 / 7 / 6 / 10" className="tile" />
    <SignatureProjectTile gridArea="4 / 1 / 8 / 5" className="tile" />
  </section>
</main>
