---
import "../styles/global.css";
import TextTile from "./tiles/TextBoxTile.astro";
import ImageTile from "./tiles/ImageTile.astro";
import LocationTile from "./tiles/LocationTile.astro";
---

<div class="bento-grid">
  <TextTile gridArea="tx" className="tile" />
  <ImageTile gridArea="im" className="tile" />
  <LocationTile gridArea="lo" className="tile" />
</div>

<style>
  .bento-grid {
    display: grid;
    width: calc(300px + 50vw);
    height: 60vh;
    gap: 12px;
    grid-template-columns: repeat(14, 1fr);
    grid-template-rows: repeat(12, 1fr);
    grid-template-areas:
      "tx tx tx tx tx tx tx tx im im im im im im"
      "tx tx tx tx tx tx tx tx im im im im im im"
      "tx tx tx tx tx tx tx tx im im im im im im"
      "tx tx tx tx tx tx tx tx im im im im im im"
      "tx tx tx tx tx tx tx tx im im im im im im"
      "tx tx tx tx tx tx tx tx im im im im im im"
      "tx tx tx tx tx tx tx tx im im im im im im"
      "tx tx tx tx tx tx tx tx im im im im im im"
      "tx tx tx tx tx tx tx tx im im im im im im"
      "tx tx tx tx tx tx tx tx im im im im im im"
      "tx tx tx tx tx tx tx tx im im im im im im"
      "tx tx tx tx tx tx tx tx .  .  lo lo lo lo";
  }

  .bento-grid :global(.tile) {
    background: var(--main-bg);
    border-radius: var(--tile-border-radius);
    /* border: 1px var(--tile-border) solid; */
    overflow: hidden;

    font-weight: bold;
    font-family: Arial;
    border-width: 1px;
    border-color: #599bb3;
    border-radius: 8px;
    box-shadow: 0px 10px 14px -7px #276873;
    text-shadow: 0px 1px 0px #3d768a;
    background: linear-gradient(#599bb3, #408c99);
  }
</style>
