---
import { themes } from "../themes/registry";
---
<nav class="style-switcher" aria-label="Portfolio style comparison">
  <label for="portfolio-style">Style concept</label>
  <button id="previous-style" type="button" aria-label="Previous theme" title="Previous theme">←</button>
  <select id="portfolio-style">
    {themes.map(theme => <option value={theme.id}>{theme.label}</option>)}
  </select>
  <button id="next-style" type="button" aria-label="Next theme" title="Next theme">→</button>
</nav>

<script>
  const select = document.querySelector<HTMLSelectElement>('#portfolio-style');
  const sheets = document.querySelectorAll<HTMLLinkElement>('link[data-style]');
  const portrait = document.querySelector<HTMLImageElement>('.photo-tile img');
  function applyStyle(id: string) {
    if (!Array.from(sheets).some(sheet => sheet.dataset.style === id)) return;
    document.documentElement.dataset.style = id;
    sheets.forEach(sheet => { sheet.media = sheet.dataset.style === id ? 'all' : 'not all'; });
    const sheet = Array.from(sheets).find(sheet => sheet.dataset.style === id)!;
    if (portrait) {
      portrait.src = sheet.dataset.portrait!;
      portrait.alt = sheet.dataset.portraitAlt!;
    }
    if (select) select.value = id;
  }
  const defaultStyle = sheets[0]?.dataset.style || '';
  applyStyle(document.documentElement.dataset.style || defaultStyle);
  function selectStyle(id: string) {
    applyStyle(id);
    const url = new URL(window.location.href);
    url.searchParams.set('style', id);
    history.replaceState(null, '', url);
  }
  select?.addEventListener('change', () => selectStyle(select.value));
  function stepStyle(direction: number) {
    if (!select || !select.options.length) return;
    const index = (select.selectedIndex + direction + select.options.length) % select.options.length;
    selectStyle(select.options[index]!.value);
  }
  document.querySelector('#previous-style')?.addEventListener('click', () => stepStyle(-1));
  document.querySelector('#next-style')?.addEventListener('click', () => stepStyle(1));
  window.addEventListener('popstate', () => {
    const id = new URLSearchParams(location.search).get('style');
    applyStyle(id && Array.from(sheets).some(sheet => sheet.dataset.style === id) ? id : defaultStyle);
  });
</script>

<style>
  .style-switcher {
    position: absolute;
    top: 12px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 10;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 12px;
    border: 1px solid #cbd0d6;
    border-radius: 8px;
    background: #fff;
    color: #20252c;
    font: 12px/1.4 Arial, sans-serif;
    white-space: nowrap;
    box-shadow: 0 2px 8px #00000010;
  }
  select {
    min-height: 30px;
    padding: 4px 8px;
    border: 1px solid #aab2bd;
    border-radius: 4px;
    background: #fff;
    color: #20252c;
    font: inherit;
    cursor: pointer;
  }
  .style-switcher button {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    padding: 0;
    border: 1px solid #aab2bd;
    border-radius: 4px;
    background: #f3f5f7;
    color: #20252c;
    font: 18px/1 Arial, sans-serif;
    box-shadow: none;
    cursor: pointer;
  }
  .style-switcher button:hover { background: #dce7f5; border-color: #6d8fb8; }
  .style-switcher button:active { background: #bdcfe5; }
  .style-switcher button:focus-visible,
  select:focus-visible { outline: 2px solid #2458ac; outline-offset: 2px; }
</style>
