---
import type { TileProps } from "./types";
import Eyebrow from "../Eyebrow.astro";
import Tile from "../Tile.astro";

type Props = TileProps;
const { gridArea, className } = Astro.props;
---

<Tile
  class:list={[className, "location-tile"]}
  gridArea={gridArea}
  aria-label="Location: Madison, Wisconsin"
>
  <div class="location-globe-space" aria-hidden="true">
    <img src="/images/location-midwest.svg" alt="" width="290" height="235" />
  </div>
  <div class="location-caption">
    <Eyebrow class="location-eyebrow">BASED IN</Eyebrow><p>Madison, WI</p>
  </div>
</Tile>

<style>
  .location-tile {
    padding: 0;
    overflow: hidden;
    background: var(--color-surface);
    display: flex;
    flex-direction: column;
  }
  .location-tile .location-globe-space {
    /* Transparent water in the SVG takes its color from this map layer. */
    --map-water: color-mix(
      in srgb,
      var(--color-accent) 50%,
      var(--color-surface)
    );
    position: absolute;
    inset: 0;
    background: var(--map-water);
    opacity: 1;
  }
  .location-globe-space img {
    position: absolute;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* A broader, gentler fade above the fully opaque text backing. */
  .location-tile .location-caption {
    position: relative;
    margin-top: auto;
    padding: 47px 22px 18px;
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--color-surface) 0%, transparent) 20.5px,
      color-mix(in srgb, var(--color-surface) 2.37%, transparent) 23.44px,
      color-mix(in srgb, var(--color-surface) 6.04%, transparent) 26.38px,
      color-mix(in srgb, var(--color-surface) 10.44%, transparent) 29.31px,
      color-mix(in srgb, var(--color-surface) 15.39%, transparent) 32.25px,
      color-mix(in srgb, var(--color-surface) 20.8%, transparent) 35.19px,
      color-mix(in srgb, var(--color-surface) 26.6%, transparent) 38.12px,
      color-mix(in srgb, var(--color-surface) 32.76%, transparent) 41.06px,
      color-mix(in srgb, var(--color-surface) 39.23%, transparent) 44px,
      color-mix(in srgb, var(--color-surface) 45.99%, transparent) 46.94px,
      color-mix(in srgb, var(--color-surface) 53.02%, transparent) 49.88px,
      color-mix(in srgb, var(--color-surface) 60.3%, transparent) 52.81px,
      color-mix(in srgb, var(--color-surface) 67.82%, transparent) 55.75px,
      color-mix(in srgb, var(--color-surface) 75.55%, transparent) 58.69px,
      color-mix(in srgb, var(--color-surface) 83.5%, transparent) 61.62px,
      color-mix(in srgb, var(--color-surface) 91.66%, transparent) 64.56px,
      color-mix(in srgb, var(--color-surface) 100%, transparent) 67.5px
    );
  }
  .location-eyebrow {
    font-size: 8px;
    letter-spacing: 0.17em;
    position: relative;
    top: 10px;
  }
  .location-caption p {
    margin-top: 5px;
    font-family: var(--font-display);
    font-size: 21px;
    letter-spacing: -0.02em;
    position: relative;
    top: 4px;
  }
  @media (max-width: 900px) {
    .location-tile .location-caption {
      padding: 47px 14px 14px;
    }
  }
  @media (max-width: 700px) {
    .location-caption p {
      font-size: 15px;
    }
    .location-tile .location-caption {
      padding: 47px 12px 12px;
    }
  }
</style>
