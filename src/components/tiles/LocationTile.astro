---
import type { TileProps } from "./types";

interface Props extends TileProps {}
const { gridArea, className = "tile" } = Astro.props;
---
<article class:list={[className, "location-tile"]} style={{ gridArea }} aria-label="Location: Madison, Wisconsin">
      <div class="location-globe-space" aria-hidden="true">
        <img src="/images/location-midwest.svg" alt="" width="290" height="235" />
      </div>
      <div class="location-caption"><span class="eyebrow">BASED IN</span><p>Madison, WI</p></div>
    </article>

<style>
  .location-tile.location-tile { padding: 0; overflow: hidden; background: #71889a; }
  .location-tile .location-globe-space { position: absolute; inset: 0; background: none; opacity: 1; }
  .location-globe-space img { position: absolute; width: 100%; height: 100%; object-fit: cover; }
  /* A broader, gentler fade above the fully opaque text backing. */
  .location-tile .location-caption { position: relative; margin-top: auto; padding: 47px 22px 18px; background: linear-gradient(to bottom, rgba(37, 56, 75, 0.0000) 20.50px, rgba(37, 56, 75, 0.0237) 23.44px, rgba(37, 56, 75, 0.0604) 26.38px, rgba(37, 56, 75, 0.1044) 29.31px, rgba(37, 56, 75, 0.1539) 32.25px, rgba(37, 56, 75, 0.2080) 35.19px, rgba(37, 56, 75, 0.2660) 38.12px, rgba(37, 56, 75, 0.3276) 41.06px, rgba(37, 56, 75, 0.3923) 44.00px, rgba(37, 56, 75, 0.4599) 46.94px, rgba(37, 56, 75, 0.5302) 49.88px, rgba(37, 56, 75, 0.6030) 52.81px, rgba(37, 56, 75, 0.6782) 55.75px, rgba(37, 56, 75, 0.7555) 58.69px, rgba(37, 56, 75, 0.8350) 61.62px, rgba(37, 56, 75, 0.9166) 64.56px, rgba(37, 56, 75, 1.0000) 67.50px); }
  .location-caption .eyebrow { position: relative; top: 10px; }
  .location-caption p { position: relative; top: 4px; }
  @media (max-width: 900px) { .location-tile .location-caption { padding: 47px 14px 14px; } }
  @media (max-width: 700px) { .location-tile .location-caption { padding: 47px 12px 12px; } }
</style>
