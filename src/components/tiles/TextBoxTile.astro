---
import type { TileProps } from "./types";

interface Props extends TileProps {}
const { gridArea, className = "tile" } = Astro.props;
---

<article class:list={[className, "paragraph-tile"]} style={{ gridArea }}>
  <h1>Hi, I'm Matthew Riggle 👋</h1>
  <p>
    I am a Computer Science and Data Science student at UW–Madison <b
      >graduating in May 2028</b
    >. Currently, I build full-stack applications At the Morgridge Institute for
    Research that support researchers nationwide. In the past I have had
    experience automating workflows at Epic and developing personal projects in
    keyboard optimization and Rust-powered web applications.
  </p>
</article>

<style>
  .paragraph-tile h1 {
    margin-top: 0;
  }
</style>
