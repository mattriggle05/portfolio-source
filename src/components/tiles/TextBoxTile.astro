---
import type { TileProps } from "./types";

interface Props extends TileProps {}
const { gridArea, className = "tile" } = Astro.props;
---
<article class:list={[className, "paragraph-tile"]} style={{ gridArea }}>
      <h1>A place for a few words.</h1>
      <p>A space to introduce the person behind the work: what sparks their curiosity, how they approach a problem, and what they enjoy building. Share a little of the thinking behind the projects, the lessons along the way, and the ideas worth exploring next.</p>
    </article>

<style>
  .paragraph-tile h1 { margin-top: 0; }
</style>
