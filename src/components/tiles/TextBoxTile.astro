---
import type { TileProps } from "./types";
import Tile from "../Tile.astro";

type Props = TileProps;
const { gridArea, className } = Astro.props;
---

<Tile class:list={[className, "paragraph-tile"]} gridArea={gridArea}>
  <h1>Hi, I'm Matthew Riggle 👋</h1>
  <p>
    I am a <b>Full-Stack Developer</b> currently studying Computer Science and Data
    Science at UW–Madison <b>graduating in May 2028</b>.
  </p>
  <p>
    My experience includes building web applications At the Morgridge Institute
    for Research, automating Benefits and HR workflows at Epic and developing
    personal projects in keyboard optimization and Rust-powered astronomical
    alignment searchers.
  </p>
</Tile>

<style>
  .paragraph-tile {
    padding: 26px 20px 20px;
    background:
      radial-gradient(
        ellipse at 100% 0,
        color-mix(in srgb, var(--color-accent) 12%, transparent),
        transparent 70%
      ),
      var(--color-surface);
  }
  h1 {
    font-family: var(--font-display);
    font-size: 34px;
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin-bottom: 8px;
  }
  p {
    margin-bottom: 8px;
    font-size: 14px;
    line-height: 1.5;
    color: var(--color-muted);
  }
  b {
    color: var(--color-accent-light);
  }
  @media (max-width: 900px) {
    h1 {
      font-size: 25px;
    }
    p {
      font-size: 12px;
      line-height: 1.65;
    }
  }
  @media (max-width: 700px) {
    h1 {
      font-size: 21px;
    }
    p {
      font-size: 11px;
      line-height: 1.5;
    }
  }
</style>
