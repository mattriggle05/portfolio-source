---
import type { TileProps } from "./types";

interface Props extends TileProps {}
const { gridArea, className = "tile" } = Astro.props;
const projects = [
  { name: 'portfolio-source', description: 'The source behind this portfolio and its visual themes.', url: 'https://github.com/mattriggle05/portfolio-source' },
  { name: 'Project placeholder 02', description: 'A short overview of the project and the problem it solves.' },
  { name: 'Project placeholder 03', description: 'A few words about the idea and how it works.' },
  { name: 'Project placeholder 04', description: 'An introduction to the tools and thinking behind the build.' },
];
---
<article class:list={[className, "stack-tile"]} style={{ gridArea }} aria-label="Projects">
      <ul>{projects.map((project) => <li><div class="project-button project-card"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 19.5V5a2 2 0 0 1 2-2h14v18H6a2 2 0 0 1 0-4h14M8 7h8M8 10h5" /></svg><span class="project-copy"><span class="project-name">{project.name}</span><span class="project-description">{project.description}</span></span><button class="repository-open signature-open" type="button" data-url={'url' in project ? project.url : undefined} aria-label={`Open ${project.name}${'url' in project ? '' : ' (placeholder)'}`}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" /></svg></button></div></li>)}</ul>
    </article>

<style>
  .stack-tile { padding: 12px 10px; }
  .stack-tile ul {
    height: 100%;
    margin: 0;
    padding: 0;
    grid-template-rows: repeat(4, minmax(60px, 1fr));
    gap: 6px;
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-gutter: stable;
  }
  .stack-tile li { min-height: 0; }
  .stack-tile .project-card { display: flex; align-items: center; width: 100%; height: 100%; min-height: 60px; padding: 4px 6px; gap: 6px; border: 1px solid color-mix(in srgb, currentColor 22%, transparent); }
  .stack-tile .project-button .project-copy { display: grid; gap: 2px; min-width: 0; flex: 1; letter-spacing: normal; }
  .stack-tile .project-card > svg { margin-inline: 4px; }
  .stack-tile .repository-open { flex-shrink: 0; width: 28px; height: 28px; padding: 5px; }
  .stack-tile .repository-open svg { width: 16px; height: 16px; color: inherit; }
  .stack-tile .project-name { font-size: 11px; font-weight: 700; line-height: 1.25; }
  .stack-tile .project-description { font-size: 8px; line-height: 1.3; font-weight: 400; letter-spacing: normal; }
  @media (max-width: 900px) {
    .stack-tile ul { grid-template-rows: repeat(4, minmax(72px, 1fr)); }
    .stack-tile { padding: 9px 7px; }
    .stack-tile .project-card { padding: 4px; gap: 4px; }
    .stack-tile .project-name { font-size: 10px; }
    .stack-tile .project-description { font-size: 7px; }
  }
  @media (max-width: 700px) {
    .stack-tile ul { grid-template-rows: repeat(4, max-content); }
    .stack-tile .project-card { height: auto; min-height: 80px; }
    .stack-tile .project-card > svg { width: 10px; height: 10px; }
    .stack-tile .project-name { font-size: 9px; }
    .stack-tile .project-description { font-size: 7px; }
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('.repository-open[data-url]').forEach(button => {
    button.addEventListener('click', () => { if (button.dataset.url) window.location.assign(button.dataset.url); });
  });
</script>
