---
import type { TileProps } from "./types";

interface Props extends TileProps {}
const { gridArea, className = "tile" } = Astro.props;
const projects = [
  {
    name: "portfolio-source",
    description:
      "A bento-style personal portfolio built with Astro and React islands.",
    url: "https://github.com/mattriggle05/portfolio-source",
    technologies: ["Astro", "React", "CSS"],
  },
  {
    name: "natal-chart-solver",
    description:
      "A React app using Rust compiled to WebAssembly to estimate birth details from star signs.",
    url: "https://github.com/mattriggle05/natal-chart-solver",
    technologies: ["Rust", "WASM", "TypeScript"],
  },
  {
    name: "key-geometry-optimizer",
    description:
      "Uses simulated annealing to optimize keyboard key positions for ergonomic hand and finger movement.",
    url: "https://github.com/mattriggle05/key-geometry-optimizer",
    technologies: ["C++", "CUDA", "Python"],
  },
];
---

<article
  class:list={[className, "stack-tile"]}
  style={{ gridArea }}
  aria-label="Projects"
>
  <ul>
    {
      projects.map((project) => (
        <li>
          <div class="project-button project-card">
            <>
              <div class="project-header">
                <>
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M4 19.5V5a2 2 0 0 1 2-2h14v18H6a2 2 0 0 1 0-4h14M8 7h8M8 10h5" />
                  </svg>
                  <span class="project-name">{project.name}</span>
                </>
              </div>
              <p class="project-description">{project.description}</p>
              <button
                class="repository-open signature-open"
                type="button"
                data-url={project.url}
                aria-label={`Open ${project.name} in a new tab`}
              >
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M5 12h14m-6-6 6 6-6 6" />
                </svg>
              </button>
              <div
                class="project-technologies"
                aria-label="Languages and tooling"
              >
                {project.technologies.map((technology) => (
                  <span class="project-pill">{technology}</span>
                ))}
              </div>
            </>
          </div>
        </li>
      ))
    }
  </ul>
</article>

<style>
  .tile.stack-tile {
    padding: 12px;
  }
  .stack-tile ul {
    height: 100%;
    margin: 0;
    padding: 0;
    grid-template-rows: repeat(3, minmax(80px, 1fr));
    gap: 6px;
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-gutter: auto;
  }
  .stack-tile li {
    min-height: 0;
  }
  .stack-tile .project-card {
    display: grid;
    position: relative;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto 1fr auto;
    align-items: start;
    width: 100%;
    height: 100%;
    min-height: 80px;
    padding: 4px 6px;
    gap: 3px;
    border: 1px solid color-mix(in srgb, currentColor 22%, transparent);
  }
  .project-header {
    display: flex;
    align-items: center;
    gap: 6px;
    min-width: 0;
    padding-bottom: 2px;
  }
  .stack-tile .project-header > svg {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
  }
  .stack-tile .repository-open {
    position: absolute;
    right: 4px;
    bottom: 3px;
    width: 28px;
    height: 28px;
    padding: 5px;
  }
  .stack-tile .repository-open svg {
    width: 16px;
    height: 16px;
    color: inherit;
  }
  .stack-tile .project-name {
    font-size: 11px;
    font-weight: 700;
    line-height: 1.25;
  }
  .stack-tile .project-description {
    margin: 0;
    font-size: 8px;
    line-height: 1.3;
    font-weight: 400;
    letter-spacing: normal;
  }
  .project-technologies {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    grid-column: 1 / -1;
    align-self: end;
    padding-right: 30px;
    min-height: 24px;
    align-items: center;
  }
  .project-pill {
    padding: 2px 6px;
    border: 1px solid color-mix(in srgb, currentColor 22%, transparent);
    border-radius: 999px;
    color: inherit;
    background: transparent;
    font-size: 8px;
    line-height: 1.2;
    font-weight: 400;
    letter-spacing: normal;
  }
  @media (max-width: 900px) {
    .stack-tile ul {
      grid-template-rows: repeat(3, minmax(80px, 1fr));
    }
    .tile.stack-tile {
      padding: 10px;
    }
    .stack-tile .project-card {
      padding: 4px;
      gap: 4px;
    }
    .stack-tile .project-name {
      font-size: 10px;
    }
    .stack-tile .project-description {
      margin: 0;
      font-size: 7px;
    }
  }
  @media (max-width: 700px) {
    .stack-tile ul {
      grid-template-rows: repeat(3, max-content);
    }
    .stack-tile .project-card {
      height: auto;
      min-height: 80px;
    }
    .stack-tile .project-name {
      font-size: 9px;
    }
    .stack-tile .project-description {
      margin: 0;
      font-size: 7px;
    }
  }
</style>

<script>
  document
    .querySelectorAll<HTMLButtonElement>(".repository-open[data-url]")
    .forEach((button) => {
      button.addEventListener("click", () => {
        if (button.dataset.url)
          window.open(button.dataset.url, "_blank", "noopener,noreferrer");
      });
    });
</script>
