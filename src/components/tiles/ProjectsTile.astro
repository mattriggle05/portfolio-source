---
import type { TileProps } from "./types";

interface Props extends TileProps {}
const { gridArea, className = "tile" } = Astro.props;
const projects = ['portfolio-source', 'Project placeholder 02', 'Project placeholder 03', 'Project placeholder 04', 'Project placeholder 05', 'Project placeholder 06'];
---
<article class:list={[className, "stack-tile"]} style={{ gridArea }} aria-label="Projects">
      <ul>{projects.map((project) => <li><button class="project-button" type="button" aria-label={`${project} (placeholder)`}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 19.5V5a2 2 0 0 1 2-2h14v18H6a2 2 0 0 1 0-4h14M8 7h8M8 10h5" /></svg><span>{project}</span><span class="project-arrow" aria-hidden="true">↗</span></button></li>)}</ul>
    </article>

<style>
  .stack-tile ul { height: 100%; margin: 0; grid-template-rows: repeat(6, minmax(0, 1fr)); gap: 8px; }
  .stack-tile li { min-height: 0; }
  .stack-tile button.project-button { height: 100%; min-height: 0; padding-block: 4px; }
  @media (max-width: 900px) { .stack-tile ul { gap: 5px; } }
  @media (max-width: 700px) {
    .stack-tile ul { gap: 4px; }
    .stack-tile button.project-button { padding-block: 2px; }
  }
</style>
