---
import type { TileProps } from "./types";
import Icon from "../Icon.astro";
import Action from "../Action.astro";
import Tile from "../Tile.astro";

type Props = TileProps;
const { gridArea, className } = Astro.props;
const projects = [
  {
    name: "portfolio-source",
    description:
      "A bento-style personal portfolio built with Astro and React islands.",
    url: "https://github.com/mattriggle05/portfolio-source",
    technologies: ["Astro", "TypeScript", "CSS"],
  },
  {
    name: "natal-chart-solver",
    description:
      "Utilizes Rust library compiled to WASM solving birthdays from star signs.",
    url: "https://github.com/mattriggle05/natal-chart-solver",
    technologies: ["Rust", "WASM", "React"],
  },
  {
    name: "key-geometry-optimizer",
    description:
      "Uses simulated annealing to create optimal ergonomic keyboards.",
    url: "https://github.com/mattriggle05/key-geometry-optimizer",
    technologies: ["C++", "CUDA", "Python"],
  },
];
---

<Tile
  class:list={[className, "stack-tile"]}
  gridArea={gridArea}
  aria-label="Projects"
>
  <ul>
    {
      projects.map((project) => (
        <li>
          <div class="project-card">
            <div class="project-header">
              <Icon
                path="M4 19.5V5a2 2 0 0 1 2-2h14v18H6a2 2 0 0 1 0-4h14M8 7h8M8 10h5"
                strokeWidth={1.6}
              />
              <span class="project-name">{project.name}</span>
            </div>
            <p class="project-description">{project.description}</p>
            <Action
              class="repository-open"
              href={project.url}
              aria-label={`Open ${project.name} in a new tab`}
            >
              <Icon path="M5 12h14m-6-6 6 6-6 6" strokeWidth={1.8} />
            </Action>
            <div
              class="project-technologies"
              aria-label="Languages and tooling"
            >
              {project.technologies.map((technology) => (
                <span class="project-pill">{technology}</span>
              ))}
            </div>
          </div>
        </li>
      ))
    }
  </ul>
</Tile>

<style>
  .stack-tile {
    padding: 12px;
  }
  .stack-tile ul {
    list-style: none;
    display: grid;
    height: 100%;
    margin: 0;
    padding: 0;
    grid-template-rows: repeat(3, minmax(80px, 1fr));
    gap: 6px;
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-gutter: auto;
  }
  .stack-tile li {
    display: flex;
    min-height: 0;
  }
  .project-card {
    border-radius: 7px;
    background: color-mix(in srgb, var(--color-background) 25%, transparent);
    display: grid;
    position: relative;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto 1fr auto;
    align-items: start;
    width: 100%;
    height: 100%;
    min-height: 80px;
    padding: 4px 6px;
    gap: 3px;
    border: 1px solid var(--color-edge);
  }
  .project-header {
    display: flex;
    align-items: center;
    gap: 6px;
    min-width: 0;
    padding-bottom: 2px;
  }
  .project-header > svg {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
  }
  .repository-open {
    position: absolute;
    right: 4px;
    bottom: 3px;
    width: 28px;
    height: 28px;
    padding: 5px;
  }
  .repository-open svg {
    width: 16px;
    height: 16px;
    color: inherit;
  }
  .project-name {
    font-size: 11px;
    font-weight: 700;
    line-height: 1.25;
  }
  .project-description {
    margin: 0;
    font-size: 10px;
    line-height: 1.3;
    font-weight: 400;
    letter-spacing: normal;
  }
  .project-technologies {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    grid-column: 1 / -1;
    align-self: end;
    padding-right: 30px;
    min-height: 24px;
    align-items: center;
  }
  .project-pill {
    padding: 2px 6px;
    border: 1px solid var(--color-edge);
    border-radius: 999px;
    color: inherit;
    background: transparent;
    font-size: 8px;
    line-height: 1.2;
    font-weight: 400;
    letter-spacing: normal;
  }
  @media (max-width: 900px) {
    .stack-tile {
      padding: 10px;
    }
    .project-card {
      padding: 4px;
      gap: 4px;
    }
    .project-name {
      font-size: 10px;
    }
    .project-description {
      font-size: 7px;
    }
  }
  @media (max-width: 700px) {
    .stack-tile ul {
      grid-template-rows: repeat(3, max-content);
    }
    .project-card {
      height: auto;
      min-height: 80px;
    }
    .project-name {
      font-size: 9px;
    }
  }
</style>
