---
import type { TileProps } from "./types";

interface Props extends TileProps {}
const { gridArea, className = "tile" } = Astro.props;
const buttons = [
  { label: 'Copy Email', filled: false, path: 'M9 9h12v12H9zM15 9V3H3v12h6' },
  { label: 'GitHub', filled: true, path: 'M12 .75a11.25 11.25 0 0 0-3.56 21.92c.56.1.77-.24.77-.54v-2.1c-3.13.68-3.79-1.33-3.79-1.33-.51-1.3-1.25-1.65-1.25-1.65-1.02-.7.08-.69.08-.69 1.13.08 1.72 1.16 1.72 1.16 1 1.72 2.63 1.22 3.27.93.1-.73.39-1.22.71-1.5-2.5-.29-5.13-1.25-5.13-5.57 0-1.23.44-2.23 1.16-3.01-.12-.29-.5-1.43.11-2.98 0 0 .95-.3 3.1 1.15a10.8 10.8 0 0 1 5.64 0c2.15-1.46 3.1-1.15 3.1-1.15.61 1.55.23 2.69.11 2.98.72.78 1.16 1.78 1.16 3.01 0 4.33-2.64 5.28-5.15 5.56.4.35.76 1.03.76 2.08v3.11c0 .3.2.65.78.54A11.25 11.25 0 0 0 12 .75Z' },
  { label: 'LinkedIn', filled: true, path: 'M20.45 2H3.55C2.69 2 2 2.68 2 3.52v16.96c0 .84.69 1.52 1.55 1.52h16.9c.86 0 1.55-.68 1.55-1.52V3.52c0-.84-.69-1.52-1.55-1.52ZM7.93 18.75H4.98V9.2h2.95v9.55ZM6.45 7.9a1.71 1.71 0 1 1 0-3.42 1.71 1.71 0 0 1 0 3.42Zm12.3 10.85H15.8V14.1c0-1.11-.02-2.54-1.55-2.54-1.55 0-1.79 1.21-1.79 2.46v4.73H9.51V9.2h2.83v1.3h.04c.39-.74 1.36-1.52 2.79-1.52 2.99 0 3.58 1.97 3.58 4.52v5.25Z' },
  { label: 'Email', filled: false, path: 'M4 4h16a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1Zm-1 2 9 7 9-7' },
];
---
<article class:list={[className, "contact-compact-tile"]} style={{ gridArea }} aria-label="Compact social and contact buttons">
      <div class="button-grid">{[...buttons.slice(1), buttons[0]].map(({ label, filled, path }) => (
        <button type="button" aria-label={label} data-copy-email={label === 'Copy Email' ? 'example@example.com' : undefined}>
          <span aria-hidden="true"><svg viewBox="0 0 24 24" fill={filled ? 'currentColor' : 'none'} stroke={filled ? 'none' : 'currentColor'} stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d={path} /></svg></span>
          <span data-button-label>{label}</span>
        </button>
      ))}</div>
      <span class="copy-status" role="status" aria-live="polite"></span>
    </article>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy-email]').forEach((button) => {
    button.addEventListener('click', async () => {
      const label = button.querySelector<HTMLElement>('[data-button-label]');
      if (!label) return;
      button.disabled = true;
      try {
        await navigator.clipboard.writeText(button.dataset.copyEmail!);
        label.textContent = 'Copied!';
        button.setAttribute('aria-label', 'Email copied');
        button.closest('article')!.querySelector('[role=status]')!.textContent = 'Email copied to clipboard';
      } catch {
        label.textContent = 'Try again';
        button.closest('article')!.querySelector('[role=status]')!.textContent = 'Could not Copy Email. Try again.';
        button.setAttribute('aria-label', 'Could not Copy Email. Try again');
      } finally {
        button.disabled = false;
      }
      window.setTimeout(() => {
        label.textContent = 'Copy Email';
        button.setAttribute('aria-label', 'Copy Email');
      }, 2000);
    });
  });
</script>

<style>
  .copy-status { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
</style>
