---
import type { TileProps } from "./types";
import Icon from "../Icon.astro";
import Action from "../Action.astro";
import Tile from "../Tile.astro";
import { formatResumeAge } from "../../utils/resumeAge";

type Props = TileProps;
const { gridArea, className } = Astro.props;
// Modification date of the supplied PDF. Update when replacing public/Matthew Riggle - Resume.pdf.
const resumeUpdated = "2026-10-22";
---

<Tile
  class:list={[className, "resume-tile"]}
  gridArea={gridArea}
  aria-label="Résumé"
>
  <Action
    class="resume-icon"
    href={`${import.meta.env.BASE_URL}Matthew%20Riggle%20-%20Resume.pdf`}
    aria-label="Open Matthew Riggle’s résumé (PDF) in a new tab"
    ><Icon path="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8ZM14 2v6h6M8 13h8M8 17h6" /></Action
  >
  <span class="resume-details">
    <span class="resume-filename">View My Resume</span>
    <span class="resume-updated"
      >PDF · Updated <time
        datetime={resumeUpdated}
        data-resume-updated
        title={resumeUpdated}>{formatResumeAge(resumeUpdated)}</time
      ></span
    >
  </span>
</Tile>

<script>
  import { formatResumeAge } from "../../utils/resumeAge";

  function updateResumeAge() {
    document
      .querySelectorAll<HTMLTimeElement>("[data-resume-updated]")
      .forEach((time) => {
        time.textContent = formatResumeAge(time.dateTime);
      });
  }

  updateResumeAge();
  document.addEventListener("astro:page-load", updateResumeAge);
  // Keep the label current when a visitor leaves the page open overnight.
  setInterval(updateResumeAge, 60_000);
</script>

<style>
  .resume-tile {
    display: flex;
    align-items: center;
    background: linear-gradient(
      110deg,
      color-mix(in srgb, var(--color-surface) 85%, var(--color-accent)),
      var(--color-surface)
    );
    padding: 12px 16px 12px 14px;
    gap: 12px;
    text-decoration: none;
  }
  .resume-details {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 0;
    gap: 6px;
  }
  .resume-filename {
    font-weight: 500;
    letter-spacing: -0.035em;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    font-size: 16px;
    line-height: 1.2;
    overflow-wrap: anywhere;
  }
  .resume-updated {
    font-size: 9px;
    line-height: 1.2;
    color: var(--color-muted);
  }
  .resume-icon {
    width: 42.2px;
    height: 42.2px;
  }
  .resume-icon svg {
    width: 23px;
    height: 23px;
  }
  @media (max-width: 900px) {
    .resume-tile {
      padding: 8px 10px 8px 8px;
      gap: 8px;
    }
    .resume-filename {
      font-size: 14px;
    }
    .resume-icon {
      width: 37.4px;
      height: 37.4px;
    }
    .resume-updated {
      font-size: 8px;
    }
  }
  @media (max-width: 700px) {
    .resume-tile {
      padding: 6px 8px 6px 6px;
      gap: 6px;
    }
    .resume-details {
      gap: 4px;
    }
    .resume-filename {
      font-size: 12px;
    }
    .resume-icon svg {
      width: 18px;
      height: 22px;
    }
    .resume-updated {
      font-size: 7px;
    }
  }
</style>
