---
import type { TileProps } from "./types";

interface Props extends TileProps {}
const { gridArea, className = "tile" } = Astro.props;
---
<article class:list={[className, "resume-tile"]} style={{ gridArea }} aria-label="Résumé download">
      <button class="resume-icon" type="button" aria-label="Download Resume.pdf (placeholder)"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8ZM14 2v6h6M8 13h8M8 17h6" /></svg></button>
      <span class="resume-details"><span class="resume-filename">Resume.pdf</span><span class="resume-updated">Last updated: date</span></span>
    </article>

<style>
  .resume-tile button.resume-icon { border-radius: 9px; }
  @media (max-width: 700px) {
    .resume-tile button.resume-icon { border-radius: 7px; }
  }
</style>
