---
import type { TileProps } from "./types";
import { formatResumeAge } from "../../utils/resumeAge";

interface Props extends TileProps {}
const { gridArea, className = "tile" } = Astro.props;
// Modification date of the supplied PDF. Update when replacing public/Matthew Riggle - Resume.pdf.
const resumeUpdated = "2026-10-22";
---
<article class:list={[className, "resume-tile"]} style={{ gridArea }} aria-label="Résumé">
      <a class="resume-icon" href={`${import.meta.env.BASE_URL}Matthew%20Riggle%20-%20Resume.pdf`} target="_blank" rel="noopener noreferrer" aria-label="Open Matthew Riggle’s resume (PDF) in a new tab"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8ZM14 2v6h6M8 13h8M8 17h6" /></svg></a>
      <span class="resume-details"><span class="eyebrow resume-eyebrow">Read more...</span><span class="resume-filename">Matthew Riggle - Resume.pdf</span><span class="resume-updated">Last updated: <time datetime={resumeUpdated} data-resume-updated title={resumeUpdated}>{formatResumeAge(resumeUpdated)}</time></span></span>
    </article>

<script>
  import { formatResumeAge } from "../../utils/resumeAge";

  function updateResumeAge() {
    document.querySelectorAll<HTMLTimeElement>("[data-resume-updated]").forEach((time) => {
      time.textContent = formatResumeAge(time.dateTime);
    });
  }

  updateResumeAge();
  document.addEventListener("astro:page-load", updateResumeAge);
  // Keep the label current when a visitor leaves the page open overnight.
  setInterval(updateResumeAge, 60_000);
</script>

<style>
  .resume-tile.resume-tile { padding: 10px 10px 10px 12px; gap: 5px; }
  .resume-tile .resume-details { container-type: inline-size; flex: 1; min-width: 0; gap: 2px; }
  .resume-tile .resume-filename { font-size: min(16px, 8cqi); white-space: nowrap; }
  .resume-eyebrow { font-size: 8px; line-height: 1.1; }
  .resume-tile a.resume-icon { width: 42.2px; height: 42.2px; border-radius: 9px; }
  .resume-icon svg { width: 60%; height: 60%; }
  @media (max-width: 900px) {
    .resume-tile a.resume-icon { width: 37.4px; height: 37.4px; }
    .resume-tile.resume-tile { padding: 6px 6px 6px 0; gap: 4px; }
  }
  @media (max-width: 700px) {
    .resume-tile.resume-tile { padding: 6px 6px 6px 0; gap: 3px; }
    .resume-tile .resume-details { gap: 1px; }
    .resume-eyebrow { font-size: 6px; }
    .resume-tile a.resume-icon { border-radius: 7px; }
  }
</style>
