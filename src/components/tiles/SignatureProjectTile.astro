---
import { Image } from "astro:assets";
import solarSystem from "../../assets/images/solar-system.png";
import type { TileProps } from "./types";
import Icon from "../Icon.astro";
import Action from "../Action.astro";
import Eyebrow from "../Eyebrow.astro";
import Tile from "../Tile.astro";

type Props = TileProps;
const { gridArea, className } = Astro.props;
---

<Tile
  class:list={[className, "signature-project"]}
  gridArea={gridArea}
  aria-labelledby="signature-title"
>
  <div class="signature-preview">
    <Image
      src={solarSystem}
      alt="Solar system visualization with planets and their orbits around the Sun"
    />
  </div>
  <div class="signature-copy">
    <div class="signature-heading">
      <div class="signature-title-group">
        <Eyebrow class="signature-eyebrow">CHECK OUT</Eyebrow>
        <h2 id="signature-title">Natal Chart Solver</h2>
      </div><Action
        class="signature-open"
        href="https://mattriggle05.github.io/natal-chart-solver/"
        aria-label="Open Natal Chart Solver (opens in a new tab)"
        ><Icon path="M6 18 18 6M6 6h12v12" strokeWidth={1.6} /></Action
      >
    </div>
    <p>
      A planetary alignment solver powered by a Rust search engine compiled to
      WebAssembly, with parallel Web Workers and a React and TypeScript
      interface.
    </p>
  </div>
</Tile>

<style>
  .signature-project {
    display: grid;
    grid-template-rows: minmax(0, 58fr) minmax(0, 42fr);
    overflow: hidden;
  }
  .signature-preview {
    min-height: 0;
    position: relative;
    background: var(--color-background);
    overflow: hidden;
    container-type: size;
    border-bottom: 0;
  }
  .signature-copy {
    min-height: 0;
    overflow: auto;
    padding: 9px 18px 12px;
    border-top: 1px solid var(--color-edge);
  }
  .signature-heading {
    gap: 10px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: stretch;
  }
  h2 {
    font-family: var(--font-display);
  }
  .signature-open svg {
    width: 17px;
    height: 17px;
  }
  .signature-eyebrow {
    display: block;
    margin-bottom: 4px;
    font-size: 9px;
    line-height: 1.2;
    letter-spacing: 0.04em;
  }
  .signature-heading h2 {
    font-size: 22px;
    line-height: 1.2;
    font-weight: 400;
    letter-spacing: -0.02em;
  }
  .signature-copy p {
    max-width: none;
    margin-top: 8px;
    font-size: 11px;
    line-height: 1.5;
    font-weight: 400;
    color: var(--color-muted);
  }
  .signature-open {
    width: 40px;
    height: 40px;
    align-self: center;
  }
  @media (max-width: 900px) {
    .signature-copy {
      padding: 8px 12px 10px;
    }
    .signature-heading h2 {
      font-size: 18px;
    }
    .signature-copy p {
      font-size: 10px;
    }
  }
  .signature-preview img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Offset the source's Sun (47.9% down) to the preview's center. */
    object-position: 49.5% calc(50% + max(1.28cqw, 2.12cqh));
  }
</style>
