---
import type { TileProps } from "./types";

interface Props extends TileProps {}
const { gridArea, className = "tile" } = Astro.props;
---
<figure class:list={[className, "photo-tile"]} style={{ gridArea }} aria-label="Reserved portrait image area"></figure>

<style>
  figure.photo-tile { background-image: none; }
  figure.photo-tile::after { content: none; }
</style>
