---
import { Image } from "astro:assets";
import portrait from "../../assets/images/portrait.png";
import type { TileProps } from "./types";
import Tile from "../Tile.astro";

type Props = TileProps;
const { gridArea, className } = Astro.props;
---

<Tile as="figure" class:list={[className, "photo-tile"]} gridArea={gridArea}>
  <Image
    src={portrait}
    alt="Portrait of Matthew Riggle"
    loading="eager"
  />
</Tile>

<style>
  .photo-tile {
    overflow: hidden;
  }
  img {
    position: absolute;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.65);
  }
</style>
